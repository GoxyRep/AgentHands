# hermes-hands configuration — copy to .env, fill in, never commit.
# https://<IP or hostname of your PiKVM> — HTTPS is enforced (no http://)
PIKVM_BASE_URL=
PIKVM_USERNAME=
# API user created in BUILD.md step A7; store the value in macOS Keychain
# (security add-generic-password) and load it into the environment.
PIKVM_PASSWORD=
# Optional: path to a CA certificate for self-signed PiKVM certs (recommended).
PIKVM_CA_FILE=
# Bootstrap-only escape hatch: skip TLS verification (NOT for production).
# Uncomment during first bring-up if you haven't pinned the CA yet:
# HERMES_HANDS_INSECURE_TLS=1
